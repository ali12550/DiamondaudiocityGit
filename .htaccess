# ==============================
# pitch detectors — Clean & SEO Safe
# ==============================

Options -Indexes


RewriteEngine On

RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.Pitchetectors\.com$ [NC]
RewriteRule ^ https://pitchdetectors.com%{REQUEST_URI} [L,R=301]

# Redirect old audiobook tool URLs → clean category URLs
RewriteRule ^audiobook-tools\.html$ https://pitchdetectors.com/audiobook/ [R=301,L]
RewriteRule ^audiobook-playback-speed-calculator\.html$ https://pitchdetectors.com/audiobook/audiobook-speed-calculator/ [R=301,L]
RewriteRule ^audiobook-speed-calculator\.html$ https://pitchdetectors.com/audiobook/audiobook-speed-calculator/ [R=301,L]
RewriteRule ^Audiobook-Length-Calculator\.html$ https://pitchdetectors.com/audiobook/audiobook-length-calculator/ [R=301,L,NC]
RewriteRule ^Audiobook-Progress-Calculator\.html$ https://pitchdetectors.com/audiobook/audiobook-progress-calculator/ [R=301,L,NC]
RewriteRule ^audiobook-percentage-calculator\.html$ https://pitchdetectors.com/audiobook/audiobook-percentage-calculator/ [R=301,L]
RewriteRule ^audiobook-price-calculator\.html$ https://pitchdetectors.com/audiobook/audiobook-price-calculator/ [R=301,L]

RewriteRule ^dj-music-production-tools/pitch-shifter/?$ /pitch-detector-tools/pitch-shift-calculator/ [R=301,L]
RewriteRule ^speaker-tools/speaker-box-volume-calculator/?$ https://pitchdetectors.com/speaker-tools/sealed-box-calculator/ [R=301,L]
RewriteRule ^bpm-to-speed\.html$ https://pitchdetectors.com/dj-music-production-tools/bpm-to-speed/ [R=301,L]


# ------------------------------
# 2. Static site_map Headers
# ------------------------------
<IfModule mod_headers.c>
  <FilesMatch "(^|/)(site_map|site_map)\.xml$">
    Header set Content-Type "application/xml; charset=UTF-8"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>


# ------------------------------
# 4. Custom 404 Page (REAL 404)
# ------------------------------
ErrorDocument 404 /404.html

# ------------------------------
# 5. Security Headers
# ------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<!-- gzip -->
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json
</IfModule>
