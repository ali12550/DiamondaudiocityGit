# ==============================
# Diamond Audio City — Clean & SEO Safe
# ==============================

Options -Indexes
RewriteEngine On

RewriteEngine On
RewriteRule ^site_map\.xml$ /site_map.php [L]

# ------------------------------
# 1. Force NON-WWW (first)
# ------------------------------
RewriteCond %{HTTP_HOST} ^www\.diamondaudiocity\.com$ [NC]
RewriteRule ^(.*)$ https://diamondaudiocity.com/$1 [L,R=301]

# Redirect old audiobook tool URL → new URL
RewriteRule ^audiobook-playback-speed-calculator\.html$ https://diamondaudiocity.com/audiobook-speed-calculator.html [R=301,L]



RewriteRule ^bpm-to-speed\.html$ https://diamondaudiocity.com/dj-music-production-tools/bpm-to-speed/ [R=301,L]

# ------------------------------
# 2. Force HTTPS (second)
# ------------------------------
RewriteCond %{HTTPS} off
RewriteRule ^ https://diamondaudiocity.com%{REQUEST_URI} [L,R=301]
# ------------------------------
# 2. Static site_map Headers
# ------------------------------
<IfModule mod_headers.c>
  <FilesMatch "(^|/)(site_map|site_map)\.xml$">
    Header set Content-Type "application/xml; charset=UTF-8"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>


# ------------------------------
# 4. Custom 404 Page (REAL 404)
# ------------------------------
ErrorDocument 404 /404.html

# ------------------------------
# 5. Security Headers
# ------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<!-- gzip -->
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json
</IfModule>
