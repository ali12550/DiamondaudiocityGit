# ==============================
# Diamond Audio City — Clean & SEO Safe
# ==============================

Options -Indexes
RewriteEngine On

# ------------------------------
# 1. Canonical Redirect (HTTPS + NON-WWW)
# ------------------------------
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.diamondaudiocity\.com$ [NC]
RewriteRule ^(.*)$ https://diamondaudiocity.com/$1 [R=301,L]

# ------------------------------
# 2. Sitemap Rewrite (canonical only)
# ------------------------------
RewriteRule ^site_map\.xml$ /site_map.php [L]


# ------------------------------
# 4. Static Sitemap Headers
# ------------------------------
<IfModule mod_headers.c>
  <FilesMatch "(^|/)(sitemap|site_map)\.xml$">
    Header set Content-Type "application/xml; charset=UTF-8"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>

# ------------------------------
# 5. Custom 404 Page
# ------------------------------
ErrorDocument 404 /404.html

# ------------------------------
# 6. Security Headers
# ------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ------------------------------
# 7. Gzip Compression
# ------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json
</IfModule>
